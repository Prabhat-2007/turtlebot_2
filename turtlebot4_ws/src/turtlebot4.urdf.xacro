<?xml version="1.0"?>
<robot name="turtlebot4" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Core iRobot Create 3 Base link definitions -->
  <xacro:include filename="$(find irobot_create_description)/urdf/create3.urdf.xacro" />

  <!-- Base macro instantiation -->
  <xacro:create3 />

  <!-- Simple Fixed Joint & Link for RPLIDAR -->
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.0 0.0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- Simple Fixed Joint & Link for OAK-D Camera -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.1 0.0 0.3" rpy="0 0 0"/>
  </joint>

</robot>
